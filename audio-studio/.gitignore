# Local virtualenv - never committed. The studio is always installed into .venv
# so the system Python is never touched.
.venv/
venv/

__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

.pytest_cache/
.coverage
htmlcov/

