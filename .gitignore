# ---- Dependencies ----
node_modules/
**/node_modules/

# ---- Large local reference material (not part of the project) ----
# ~600 MB of captured artifacts (duplicate videos, audio, vendor bundles).
# Kept on disk for local research only, deliberately out of version control.
referece_material/
**/referece_material/

# A downloaded font pack (21 styles). Local research material — it stays on disk, not in history.
# The one face whose licence permits redistribution is committed from src/fonts/packaged/, which has
# its own .gitignore and its own note about licensing; the pack itself, and its other 20 styles, do
# not belong in a commit.
hibernal_sentry/

# ---- Research notes that must not be published ----
# Raw, leak-heavy source analysis. The sanitized, publishable version lives at
# caption-studio/docs/KNOWLEDGE-BASE.md.
caption-studio/docs/KNOWLEDGE-BASE.internal.md

# Local research documents kept off the published tree.
Gemini-Local HTML5 Subtitle Renderer-20260926-1210.md
VEED-Subtitle-Replication-Complete-Understanding.md

# ---- Local secrets ----
# Never commit an API key. audio-studio's optional [llm] validation extra reads
# one from here (or from GEMINI_API_KEY / OPENROUTER_API_KEY in the env).
gemini_api_key.txt
*.api_key

# ---- Local agent/tooling state ----
# Ignored locally via .git/info/exclude too, but that file is not cloned — so the rule lives here as
# well, or a fresh clone is one `git add -A` away from committing session state.
/.freebuff/

# ---- Machine-specific / OS junk ----
*.lnk
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
.cache/

# ---- Editor / tooling ----
.vscode/
.idea/
.venv/
venv/
__pycache__/

# ---- Local archive dumps ----
# Ad-hoc zips/7z of the tree. They are scratch exports, and the ones taken while the
# reference material was still on disk contain it, so they stay out of history.
*.7z
*.zip
*.rar
*.tar.gz

# ---- Build output ----
dist/
build/
coverage/
